{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orderflow_payments;Username=root;Password=123456"
  },
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://localhost:3100",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:3101",
        "Protocols": "Http2"
      }
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "payments",
    "PollingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
