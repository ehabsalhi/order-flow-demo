{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orderflow;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_SECURE_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "OrderFlow.MainServer",
    "Audience": "OrderFlow.Clients",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
